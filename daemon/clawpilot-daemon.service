[Unit]
Description=ClawPilot Deploy Daemon
Documentation=https://github.com/clawpilot/clawpilot
After=network.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/clawpilot-daemon --listen 127.0.0.1:16668
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=clawpilot-daemon

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
