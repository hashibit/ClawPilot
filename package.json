{
  "name": "clawpilot",
  "version": "0.1.0",
  "description": "OpenClaw 可视化团队配置管理桌面应用",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "stop": "echo 'Stopping ClawPilot services...' && (cat .dev-ports 2>/dev/null | tr ' ' ',' | xargs -I{} lsof -ti:{} | xargs kill -9 2>/dev/null || lsof -ti:16666,16667,16668 | xargs kill -9 2>/dev/null); echo 'Done'",
    "build": "make all",
    "build:frontend": "make frontend",
    "build:daemon": "make daemon",
    "build:tauri": "make tauri",
    "build:release": "make release",
    "build:cross": "make daemon CROSS=1",
    "clean": "make clean",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "server": "cd server && npm start",
    "server:dev": "cd server && npm run dev",
    "dev:web": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "make check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "i18next": "^25.10.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.6.0",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.0.0",
    "concurrently": "^9.2.1",
    "jsdom": "^24.1.0",
    "msw": "^2.0.0",
    "sharp": "^0.34.5",
    "typescript": "^5.5.3",
    "vite": "^5.4.2",
    "vitest": "^2.0.0"
  }
}
